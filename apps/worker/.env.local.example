# Mesmas credenciais de apps/web/.env.local.example — o worker roda os
# mesmos jobs (checagem de preço, self-healing, resumo diário) fora do
# processo do Next.js, então precisa do mesmo acesso.

# Supabase — Settings > API no painel do projeto (service role, não a publishable key)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Anthropic API — usada no cadastro/self-healing de concorrentes (Etapa 3/7)
ANTHROPIC_API_KEY=

# Resend — envio do resumo diário por e-mail
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# URL pública do app — usada pra montar o link do relatório no resumo diário
APP_BASE_URL=http://localhost:3000

# Ajustes do worker (opcionais, têm default sensato no código)
# de quanto em quanto tempo verifica quem está devido de checagem (ms)
WORKER_CHECK_INTERVAL_MS=60000
# hora (UTC, 0-23) em que o resumo diário é enviado
DAILY_DIGEST_HOUR_UTC=23

{
  "name": "worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build --workspace=scraper",
    "dev": "node --env-file=.env.local --import tsx src/index.ts",
    "build": "npm run build --workspace=scraper && tsc -p tsconfig.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "scraper": "*"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.23.0",
    "typescript": "^5"
  }
}

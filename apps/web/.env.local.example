# Supabase — Settings > API no painel do projeto
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Anthropic API — usada apenas no cadastro/self-healing de concorrentes
ANTHROPIC_API_KEY=

# Resend — envio de e-mail (integração pronta; email_enabled nasce false por conta)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# WhatsApp — em standby deliberado (custo/tempo de aprovação como BSP, risco
# residual mesmo na via oficial); adapter "noop" até essa decisão ser revisitada
WHATSAPP_PROVIDER=noop

# URL pública do app — usada só pra montar links absolutos em e-mails (ex:
# resumo diário linkando pro relatório do dia). Em dev, aponta pro localhost;
# em produção, precisa ser o domínio real.
APP_BASE_URL=http://localhost:3000
